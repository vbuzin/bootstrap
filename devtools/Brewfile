# Shared language / CLI toolchain — editor-agnostic (nvim, Zed, terminal).
# Installed via `make dev-tools`. Not for apps/fonts/shell (see root Brewfile).

# Runtimes / toolchain managers
brew "rustup" # keg-only; PATH via dot-zshrc
brew "deno"

# Lua
brew "lua-language-server"
brew "stylua"

# TOML
brew "taplo"

# Containers — CLI only (not the Docker Desktop cask). Daemon is Colima.
brew "colima"
brew "docker"
brew "docker-compose"
brew "docker-buildx"
brew "docker-credential-helper"
