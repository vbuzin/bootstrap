# ==============================================================================
# SECTION 1: GLOBAL ENVIRONMENT (Runs for IDEs and Terminal)
# ==============================================================================

# 1. Path Configuration
# Ensure FZF is in the path so IDEs can see it.
if [[ ! "$PATH" == */opt/homebrew/opt/fzf/bin* ]]; then
  PATH="${PATH:+${PATH}:}/opt/homebrew/opt/fzf/bin"
fi

if command -v rustup >/dev/null 2>&1; then
  PATH="${PATH:+${PATH}:}${HOME}/.cargo/bin:$(brew --prefix rustup)/bin"
fi

# 2. Secrets
if [[ -x "$HOME/.grok/bin/grok" ]]; then
  # grok is installed and manages its own auth (browser login, auth.json, etc.).
  # XAI_API_KEY has highest precedence in grok's chain, so we must not let a
  # stale keychain value leak in. Also cleans up the var on re-source after install.
  unset XAI_API_KEY
else
  export XAI_API_KEY="$(security find-generic-password -s "XAI_API_KEY" -w 2>/dev/null || echo '')"
fi
export SSH_PRIVATE_KEY="$(security find-generic-password -s "ssh-ed25519-private" -w 2>/dev/null | base64 -d || echo '')"

# 3. Other
export GROK_LSP_TOOLS=1
export GROK_MEMORY=1

# ==============================================================================
# SECTION 2: INTERACTIVE SHELL (Human use only)
# Everything below is skipped by JetBrains/Automation to prevent timeouts.
# ==============================================================================

if [[ $- == *i* ]]; then

  # 1. Homebrew fpath — must be set before compinit runs in init.zsh
  if command -v brew >/dev/null 2>&1; then
    if [[ -d "/opt/homebrew/share/zsh/site-functions" ]]; then
      fpath=("/opt/homebrew/share/zsh/site-functions" $fpath)
    else
      BREW_PREFIX=$(brew --prefix)
      [[ -d "$BREW_PREFIX/share/zsh/site-functions" ]] && \
        fpath=("$BREW_PREFIX/share/zsh/site-functions" $fpath)
    fi
  fi

  # 2. Modular shell config — exports, options, completion, aliases,
  #    functions, fzf bindings, plugins, starship, direnv.
  #    See ~/.config/zsh-extra/init.zsh for the full load order.
  source "$HOME/.config/zsh-extra/init.zsh"

  # SSH Agent + load private key from iCloud-synced Keychain
  if [[ -n "${SSH_PRIVATE_KEY:-}" ]]; then
    # start agent if missing
    if [[ -z "${SSH_AUTH_SOCK:-}" ]] || [[ ! -S "$SSH_AUTH_SOCK" ]]; then
      eval "$(ssh-agent -s)" >/dev/null
    fi

    # load key once (quietly)
    if ! ssh-add -l 2>/dev/null | grep -q "ed25519"; then
      printf '%s\n' "$SSH_PRIVATE_KEY" | ssh-add - 2>/dev/null || true
    fi
  fi
fi

# GROK_HOME intentionally not set (see bootstrap history).
# We had it pointing at ~/.config/grok for a while, which caused session
# discovery bugs. Keeping everything in the standard ~/.grok/ for now.
