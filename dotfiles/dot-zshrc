# .zshrc — interactive shells only (zsh never reads it for scripts or
# non-interactive IDE shells; env those need lives in .zshenv / .zprofile).

# Login shells already sourced /etc/zprofile + ~/.zprofile (path_helper puts
# Homebrew on PATH, then EDITOR/LANG/PATH extras). Non-login interactive
# shells — Zellij panes, some IDE terminals — skip those files, so pull them in.
if [[ ! -o login ]]; then
  [[ -r /etc/zprofile ]] && source /etc/zprofile
  [[ -r "${ZDOTDIR:-$HOME}/.zprofile" ]] && source "${ZDOTDIR:-$HOME}/.zprofile"
fi

# Modular shell config — exports, options, completion, aliases, functions,
# fzf, plugins, starship, direnv. See init.zsh for the load order.
source "$HOME/.config/zsh-extra/init.zsh"
